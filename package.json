{
  "name": "oh-my-webbridge",
  "version": "0.2.2",
  "private": true,
  "description": "A local browser bridge for agents: Go daemon, Chrome and Firefox MV3 extensions, task sessions and CDP.",
  "homepage": "https://oh-my-webbridge.github.io",
  "bugs": "https://github.com/oh-my-webbridge/oh-my-webbridge/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oh-my-webbridge/oh-my-webbridge.git"
  },
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "oxlint --type-aware --type-check --deny-warnings --format=agent",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "i18n": "node scripts/i18n.mjs",
    "i18n:check": "node scripts/i18n.mjs --check",
    "test": "node --test tests/sdk.test.mjs tests/benchmark.test.mjs tests/id.test.mjs tests/state.test.mjs tests/suggestions.test.mjs tests/worker.test.mjs tests/activity.test.mjs tests/indicator.test.mjs tests/release.test.mjs tests/stores.test.mjs tests/presets.test.mjs tests/preset-lifecycle.test.mjs tests/actions.test.mjs tests/firefox-worker.test.mjs tests/firefox-actions.test.mjs tests/firefox-presets.test.mjs tests/firefox-bidi.test.mjs",
    "test:e2e": "node --test tests/e2e.test.mjs",
    "test:e2e:firefox": "node --test tests/e2e-firefox.test.mjs",
    "test:e2e:firefox-page": "node --test tests/firefox-page.test.mjs",
    "test:e2e:dual": "node --test tests/e2e-dual.test.mjs",
    "bench": "node benchmarks/run.mjs",
    "release:pack": "node scripts/package-release.mjs",
    "changeset": "changeset",
    "release:plan": "node scripts/release.mjs plan",
    "release:version": "node scripts/release.mjs version",
    "release:check": "node scripts/release.mjs check",
    "filters:update": "node scripts/update-filters.mjs",
    "release:audit": "node scripts/audit-release.mjs",
    "media": "node scripts/media/record.mjs"
  },
  "dependencies": {
    "@ghostery/adblocker": "2.20.3"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@oh-my-webbridge/brand": "workspace:*",
    "@oh-my-webbridge/extension-ui": "workspace:*",
    "@resvg/resvg-js": "2.6.2",
    "@types/chrome": "0.3.7",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "jose": "6.2.16",
    "lucide-static": "1.70.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-to-markdown": "2.2.3",
    "micromark-extension-gfm": "3.0.0",
    "opencc-js": "1.4.2",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "parse5": "8.1.1",
    "playwright-core": "1.65.0",
    "typescript": "7.0.2",
    "ws": "8.22.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.28.5"
}
